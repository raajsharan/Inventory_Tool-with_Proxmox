[Unit]
Description=Infrastructure Inventory API (Node.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/inventory/backend
EnvironmentFile=/opt/inventory/backend/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
# Log to the journal — file paths crash the unit (status=209/STDOUT) when the
# directory is missing. Read logs with: journalctl -u inventory-backend
StandardOutput=journal
StandardError=journal
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
